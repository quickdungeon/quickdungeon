# Quick Dungeon static site: plain HTTP on port 8080, for local use or behind a reverse proxy
# or platform that handles TLS. (https://quickdungeon.app itself is served by Cloudflare,
# which reads the same headers from site/static/_headers.)
{
	admin off
}

(static_site) {
	root * /srv
	encode zstd gzip
	file_server {
		hide _headers
	}

	# Cloudflare gets the same headers from site/static/_headers: keep the two in step.
	# The CSP allows Cloudflare Web Analytics (see the analytics partial); nothing else external.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Fingerprinted CSS/JS and Hugo-processed images never change: cache for a year.
	@immutable path_regexp (\.[0-9a-f]{64}\.(css|js)|_hu_?[0-9a-f]+.*\.webp)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@assets path *.jpg *.jpeg *.png *.webp *.svg *.ico *.woff2
	header @assets ?Cache-Control "public, max-age=604800"
	@pages path / *.html */
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}

:8080 {
	import static_site
}

# Container health check (plain HTTP, not published).
http://:8081 {
	respond /healthz "ok" 200
	respond 404
}
