# Quick Dungeon static site.
#
# SITE_ADDRESS decides how Caddy serves the site:
#   :8080 (default)    plain HTTP on port 8080: local use, or behind a reverse proxy or a
#                      platform that handles TLS for you
#   quickdungeon.com   automatic HTTPS via Let's Encrypt on ports 80 and 443. DNS must point
#                      at this server and /data must be persisted (see compose.https.yaml).
#                      Several names are allowed: "quickdungeon.com, www.quickdungeon.com"
{
	admin off
}

(static_site) {
	root * /srv
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Fingerprinted CSS/JS and Hugo-processed images never change: cache for a year.
	@immutable path_regexp (\.[0-9a-f]{64}\.(css|js)|_hu_?[0-9a-f]+.*\.webp)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@assets path *.jpg *.jpeg *.png *.webp *.svg *.woff2
	header @assets ?Cache-Control "public, max-age=604800"
	@pages path / *.html */
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}

{$SITE_ADDRESS::8080} {
	import static_site
}

# Container health check (plain HTTP, not published).
http://:8081 {
	respond /healthz "ok" 200
	respond 404
}
